# Скопируй в .env и заполни. Файл .env в .gitignore и в репозиторий не попадает.

# --- слот портов и имя compose-проекта ---
# Это порты, публикуемые на хост. В каждом worktree свой свободный слот,
# см. docs/worktrees.md и реестр .dev-notes/worktrees.md
COMPOSE_PROJECT_NAME=hackalem-main
FRONTEND_PORT=3000
BACKEND_PORT=8000
DB_PORT=5432

# --- база данных ---
# POSTGRES_HOST и POSTGRES_PORT — адрес БД внутри сети compose, их менять не нужно.
# Строку подключения backend собирает сам из этих переменных.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=app
POSTGRES_PASSWORD=change_me
POSTGRES_DB=app

# --- приложение ---
ENVIRONMENT=local
DEBUG=False
SECRET_KEY=change_me_generate_a_long_random_value

# --- пайплайн прогноза ---
# Каталоги с исходными данными и результатами. Пустое значение означает каталоги
# репозитория: data/, outputs/ и reports/. Менять их нужно только при запуске
# через uv из нестандартного места: в образе эти пути задает сервис pipeline
# из docker-compose.yml.
DATA_DIR=
OUTPUT_DIR=
REPORTS_DIR=

# --- внешние сервисы ---
# Ключи не коммитить. OpenAI выдается организаторами, ключ 21st.dev берется на 21st.dev/mcp
OPENAI_API_KEY=
API_KEY_21ST=

# --- первый администратор для демонстрации ---
# Пароль можно оставить пустым: скрипт сгенерирует случайный и напечатает его один раз.
SEED_ADMIN_EMAIL=admin@hackalem.local
SEED_ADMIN_PASSWORD=

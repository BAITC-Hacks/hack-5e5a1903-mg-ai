{
  "openapi": "3.1.0",
  "info": {
    "title": "HackAlem ML Service",
    "description": "\nПочасовой вероятностный прогноз выработки двух турбин ВЭС «Шелек» и станции целиком.\n\n**Кто вызывает.** Только backend: агент собирает прогнозы погоды, доступные на момент T,\nи отправляет их в `POST /v1/predict`. Frontend к сервису напрямую не ходит.\n\n**Единицы.** `p10`, `p50`, `p90` — доля от номинальной мощности цели (0…1). Номиналы в `capacity_mw`.\nСкорости ветра — м/с: у Open-Meteo нужно запрашивать `wind_speed_unit=ms`, по умолчанию там км/ч.\n\n**Ошибки.** Всегда конверт `{\"error\": {\"code\", \"message\", \"details\"}}`, как в backend.\nКлиент ставит таймаут, при таймауте или 5xx агент переходит на запасной прогноз.\n",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Жив ли сервис и какая модель загружена",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/model": {
      "get": {
        "tags": [
          "Model"
        ],
        "summary": "Паспорт модели: входы, признаки, важность, кривая мощности, метрики",
        "operationId": "model_card_v1_model_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelCard"
                }
              }
            }
          }
        }
      }
    },
    "/v1/model/backtest": {
      "get": {
        "tags": [
          "Model"
        ],
        "summary": "Проверка модели на отложенном периоде: выпуски, прогноз и факт по часам",
        "operationId": "backtest_v1_model_backtest_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BacktestReport"
                }
              }
            }
          },
          "404": {
            "description": "Отчет еще не собран: BACKTEST_NOT_AVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/predict": {
      "post": {
        "tags": [
          "Forecast"
        ],
        "summary": "Прогноз P10/P50/P90 на часы T+1 … T+48 по прогнозам погоды, доступным к T",
        "operationId": "predict_v1_predict_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PredictRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictResponse"
                }
              }
            }
          },
          "422": {
            "description": "Вход не соответствует контракту или нарушает правило «только погода, доступная к T»",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Внутренняя ошибка сервиса",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },

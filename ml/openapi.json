{
  "openapi": "3.1.0",
  "info": {
    "title": "HackAlem ML Service",
    "description": "\nПочасовой вероятностный прогноз выработки двух турбин ВЭС «Шелек» и станции целиком.\n\n**Кто вызывает.** Только backend: берет строки погоды, доступные на момент T, из `GET /nwp`\nсервиса погоды и отправляет их как есть в `POST /predict`. Frontend к сервису напрямую не ходит.\nОбщая схема: `docs/api-contract.md`.\n\n**Единицы.** `p10`, `p50`, `p90` — доля от номинальной мощности (0…1). Номиналы в `capacity_mw`.\nСкорости ветра — м/с: у Open-Meteo нужно запрашивать `wind_speed_unit=ms`, по умолчанию там км/ч.\n\n**Ошибки.** Всегда конверт `{\"error\": {\"code\", \"message\", \"details\"}}`, как в backend.\nКлиент ставит таймаут, при таймауте или 5xx агент переходит на запасной прогноз.\n",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Жив ли сервис и какая модель загружена",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/model-info": {
      "get": {
        "tags": [
          "Model"
        ],
        "summary": "Паспорт модели: входы, признаки с важностью, кривая мощности, окно обучения",
        "operationId": "model_info_model_info_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelInfo"
                }
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "tags": [
          "Model"
        ],
        "summary": "Качество на отложенном периоде: nMAE D+1 и D+2, nRMSE, skill, покрытие P10–P90, по дням и по часам горизонта",
        "operationId": "metrics_metrics_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelMetrics"
                }
              }
            }
          },
          "404": {
            "description": "Метрики еще не посчитаны: METRICS_NOT_AVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/predict": {
      "post": {
        "tags": [
          "Forecast"
        ],
        "summary": "Прогноз P10/P50/P90 на часы T+1 … T+48 по прогнозам погоды, доступным к T",
        "operationId": "predict_predict_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PredictRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictResponse"
                }
              }
            }
          },
          "422": {
            "description": "Вход не соответствует контракту или нарушает правило «только погода, доступная к T»",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Внутренняя ошибка сервиса",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BaselineScore": {

# Скопируйте в .env рядом с этим файлом. Без ключа сервис работает в режиме близости текстов.
OPENAI_API_KEY=
# модель для проверки спорных мест, рекомендаций и извлечения владельцев
ORGDIFF_MODEL=gpt-4.1-mini
# порт на хосте для docker compose
ORGDIFF_PORT=8765
# таймаут одного обращения к модели в секундах
ORGDIFF_LLM_TIMEOUT=60
